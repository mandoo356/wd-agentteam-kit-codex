# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채우세요.
#
# 🔒 .env 는 비밀번호와 같습니다. 남에게 주거나 인터넷에 올리지 마세요.
#
# 값 받아오는 법은 교안의 슬랙 ①·②를 보세요. 열쇠 3개 모두 필수입니다.
# 환경점검.bat에서 붙여넣으면 .env를 BOM 없이 저장하고 연결을 점검합니다.

# 슬랙 봇 토큰 — xoxb- 로 시작합니다
SLACK_BOT_TOKEN=

# 슬랙 앱 토큰 — xapp- 로 시작합니다
SLACK_APP_TOKEN=

# 내 워크스페이스에서 내 멤버 ID (U 또는 W로 시작). 비우면 서버가 켜지지 않습니다.
# 슬랙 앱 → 내 프로필 사진 → 프로필 → ⋯ 더보기 → 멤버 ID 복사
OWNER_USER_ID=

# 보통 비워둡니다. Codex를 못 찾을 때만 codex.cmd의 전체 경로를 적으세요.
CODEX_CLI=

# 강의 기본값 1 = YOLO(전체 권한·승인 생략). 0이면 workspace-write로 제한합니다.
CODEX_YOLO=1
