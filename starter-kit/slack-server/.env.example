# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채우세요.
#
# 🔒 .env 는 비밀번호와 같습니다. 남에게 주거나 인터넷에 올리지 마세요.
#
# 값 받아오는 법은 사전 안내문 "슬랙 앱 만들기" 를 보세요.
# (모듈 4 시작 전까지 미리 받아두셔야 합니다)

# 슬랙 봇 토큰 — xoxb- 로 시작합니다
SLACK_BOT_TOKEN=

# 슬랙 앱 토큰 — xapp- 로 시작합니다
SLACK_APP_TOKEN=

# 내 워크스페이스에서 내 사용자 ID (U 로 시작). 모르면 비워두세요.
OWNER_USER_ID=
